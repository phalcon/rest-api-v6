includes:
    # Four remaining errors, all Phase 2 items:
    #
    #   - Three fetchAll()/fetchOne() calls on the query builder. These are
    #     real at runtime, routed through Select::__call(), which no static
    #     analyser can resolve. They clear when the repositories move to an
    #     explicit fetch API.
    #   - Phalcon\Support\Collection became generic, so EnvManager needs an
    #     @extends annotation.
    #
    # Nothing may be added to this baseline without a matching Phase 2 item.
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - ../src
        - ../public/index.php
    reportUnmatchedIgnoredErrors: false
    tmpDir: ../tests/_output
    bootstrapFiles:
        - ../vendor/autoload.php
