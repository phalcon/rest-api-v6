# Docker
PROJECT_PREFIX="rest-api"
PHP_VERSION=8.5
APP_PORT=8080
UID=1000
GID=1000

# Environment
# APP_ENV is deliberately unset: EnvManager::appEnv() already defaults to
# "development", and exporting it into the container environment would
# override what the tests set in $_ENV.
APP_ENV_ADAPTER="dotenv"

# MariaDB
DB_HOST="rest-api-db"
DB_PORT=3306
DB_USER="root"
DB_PASS="secret"
DB_NAME="phalcon"
DB_CHARSET="utf8"

# Cache
CACHE_ADAPTER="redis"
CACHE_HOST="rest-api-cache"
CACHE_PORT=6379
CACHE_INDEX="0"
CACHE_LIFETIME=86400
CACHE_PREFIX="-rest-"

# Logger
LOG_FILENAME="rest-api"
LOG_PATH="storage/logs"

# JWT
TOKEN_EXPIRATION=14400
TOKEN_AUDIENCE="https://rest-api.phalcon.io"
